<Window x:Class="Clocteck.CubicCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Clocteck Cubic Center"
        Width="1180" Height="760" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource WindowBackground}">
    <Grid>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#070909" />
        <Border x:Name="LoadingOverlay" Background="#070909">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="CLOCTECK" Foreground="#D8FF52" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="正在启动设备中心…" Foreground="#8E9A92" FontSize="13" Margin="0,13,0,0" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="180" Height="3" Margin="0,20,0,0" Foreground="#B9F227" Background="#202620" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
