<Window x:Class="Clocteck.CubicCenter.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="设备网页"
        Width="1040" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#070909">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#101412" BorderBrush="#29312C" BorderThickness="0,0,0,1">
            <Grid Margin="10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="←" Width="34" Margin="0,0,6,0" Click="BackButton_OnClick" />
                <Button Grid.Column="1" Content="↻" Width="34" Margin="0,0,8,0" Click="ReloadButton_OnClick" />
                <TextBox x:Name="AddressBox" Grid.Column="2" IsReadOnly="True" VerticalContentAlignment="Center" Padding="10,0" Background="#191F1B" Foreground="#D9E2DC" BorderBrush="#2B3630" />
                <Button Grid.Column="3" Content="在浏览器打开" Margin="8,0,0,0" Padding="12,0" Click="ExternalButton_OnClick" />
            </Grid>
        </Border>
        <wv2:WebView2 x:Name="Browser" Grid.Row="1" DefaultBackgroundColor="#FFFFFF" />
    </Grid>
</Window>
